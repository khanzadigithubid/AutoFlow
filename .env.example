# AutoFlow environment settings
# Copy this file to .env and fill in real values.
# NOTE: .env file is git-ignored - never commit real credentials.

# Flask secret key (koi bhi random string)
SECRET_KEY=change-me-to-random-string

# App branding
APP_NAME=AutoFlow

# SMTP settings (Gmail example)
# Gmail ke liye: myaccount.google.com/apppasswords se 16-digit app password banayein
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=aapka@gmail.com
SMTP_PASS=your-16-digit-app-password
MAIL_FROM=aapka@gmail.com

# Jis email pe new lead notification jayega
OWNER_EMAIL=owner@company.com
